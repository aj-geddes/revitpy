{
  "name": "@revitpy/dev-server",
  "version": "2.0.0",
  "description": "Watch Python files and hot-reload them into a running Revit through the RevitPy Live Server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "revitpy-dev-server": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "keywords": [
    "revit",
    "revitpy",
    "python",
    "hot-reload",
    "live-reload"
  ],
  "author": "RevitPy Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aj-geddes/revitpy.git",
    "directory": "dev-server"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^14.0.3",
    "picomatch": "^4.0.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@types/picomatch": "^4.0.3",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
