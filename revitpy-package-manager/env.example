# RevitPy Package Manager - Environment Configuration
# Copy this file to .env and fill in the values:  cp env.example .env
# (Named env.example rather than .env.example because the repository
#  .gitignore excludes .env.* files.)
#
# Generate secrets with:  openssl rand -hex 32

# ==============================================================================
# DOCKER COMPOSE SECRETS (REQUIRED - no defaults)
# ==============================================================================
# docker-compose.yml and docker-compose.desktop.yml use ${VAR:?} interpolation:
# compose refuses to start while any of these is unset or empty.

# JWT signing secret (both compose files; minimum 32 characters)
JWT_SECRET_KEY=

# docker-compose.desktop.yml: admin token for the desktop registry
ADMIN_TOKEN=

# docker-compose.yml: PostgreSQL (the password is embedded in DB_URL, so
# avoid URL-reserved characters such as @ : / ? #, or percent-encode them)
POSTGRES_PASSWORD=
# Optional overrides (defaults shown)
# POSTGRES_USER=revitpy
# POSTGRES_DB=revitpy_registry

# docker-compose.yml: MinIO root credentials, also used by the registry as
# its S3 access key/secret (password must be at least 8 characters)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# MinIO no longer publishes public images on Docker Hub; set this to a pinned
# image you trust (e.g. a mirrored/self-built minio image or an S3-compatible
# alternative). Defaults to "minio/minio" when unset.
# MINIO_IMAGE=

# docker-compose.yml: Grafana admin login
GRAFANA_ADMIN_PASSWORD=
# GRAFANA_ADMIN_USER=admin

# ==============================================================================
# APPLICATION ENVIRONMENT
# ==============================================================================
# Options: development, staging, production, testing
ENVIRONMENT=development

# Application metadata
APP_NAME="RevitPy Package Registry"
APP_VERSION="1.0.0"

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Database connection URL (PostgreSQL)
# Format: postgresql+asyncpg://user:password@host:port/database
DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/revitpy

# Enable SQL query logging (for debugging)
DB_ECHO=false

# Connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Legacy support (if DB_URL is not set, falls back to DATABASE_URL)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/revitpy

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
# JWT secret key (REQUIRED, minimum 32 characters)
# Generate with: openssl rand -hex 32
# JWT_SECRET_KEY is set in the Docker Compose section above

# JWT signing algorithm
JWT_ALGORITHM=HS256

# Token expiration times
JWT_EXPIRE_HOURS=24
JWT_REFRESH_EXPIRE_DAYS=30

# ==============================================================================
# STORAGE CONFIGURATION
# ==============================================================================
# Storage backend type: local, s3, azure
STORAGE_TYPE=local

# Local storage settings
STORAGE_LOCAL_PATH=./storage/packages

# S3 storage settings (if STORAGE_TYPE=s3)
STORAGE_S3_BUCKET_NAME=revitpy-packages
STORAGE_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# Optional: for S3-compatible services (e.g., MinIO)
# STORAGE_S3_ENDPOINT_URL=https://s3.example.com

# Azure storage settings (if STORAGE_TYPE=azure)
# STORAGE_AZURE_ACCOUNT_NAME=your-azure-account
# STORAGE_AZURE_ACCOUNT_KEY=your-azure-account-key
STORAGE_AZURE_CONTAINER_NAME=revitpy-packages

# ==============================================================================
# CACHE CONFIGURATION (REDIS)
# ==============================================================================
# Enable caching
CACHE_ENABLED=true

# Redis connection URL
CACHE_REDIS_URL=redis://localhost:6379/0

# Cache TTL settings (in seconds)
CACHE_TTL_DEFAULT=3600
CACHE_TTL_STATS=300

# Redis memory limit
CACHE_MAX_MEMORY=256mb

# ==============================================================================
# API SERVER CONFIGURATION
# ==============================================================================
# Server bind address and port
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Number of worker processes (None = auto-detect based on CPU cores)
# SERVER_WORKERS=4

# Development settings
SERVER_RELOAD=false
SERVER_DEBUG=false

# CORS allowed origins (comma-separated or as environment list)
SERVER_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://registry.revitpy.dev,https://hub.revitpy.dev

# Trusted host headers
SERVER_TRUSTED_HOSTS=localhost,127.0.0.1,registry.revitpy.dev,*.revitpy.dev

# ==============================================================================
# MONITORING & OBSERVABILITY
# ==============================================================================
# Enable monitoring and metrics
MONITORING_ENABLED=true

# Sentry DSN for error tracking (optional)
# MONITORING_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Logging configuration
MONITORING_LOG_LEVEL=INFO
MONITORING_LOG_JSON=false

# Prometheus metrics
MONITORING_METRICS_ENABLED=true

# ==============================================================================
# SECURITY SETTINGS
# ==============================================================================
# Password requirements
SECURITY_MIN_PASSWORD_LENGTH=12

# File upload limits (in bytes)
SECURITY_MAX_UPLOAD_SIZE=104857600  # 100MB
SECURITY_MAX_REQUEST_SIZE=10485760  # 10MB

# Rate limiting
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_DEFAULT=100/minute
SECURITY_RATE_LIMIT_AUTH=10/minute
SECURITY_RATE_LIMIT_UPLOAD=5/minute

# Allowed file extensions (comma-separated)
# Default: .py,.pyi,.pyc,.pyo,.pyd,.txt,.md,.rst,.yaml,.yml,.json,.toml,.cfg,.ini,.conf,.zip,.tar.gz,.whl
# SECURITY_ALLOWED_EXTENSIONS=.py,.txt,.md

# ==============================================================================
# CLI & DESKTOP APPLICATION
# ==============================================================================
# CLI debug mode
CLI_DEBUG=false

# RevitPy registry authentication token
# CLI_REVITPY_TOKEN=your-api-token

# Package registry URL
CLI_REGISTRY_URL=https://registry.revitpy.dev

# Windows Program Files paths (override defaults)
# CLI_PROGRAM_FILES=C:\Program Files
# CLI_PROGRAM_FILES_X86=C:\Program Files (x86)

# ==============================================================================
# NOTES
# ==============================================================================
# 1. All settings have sensible defaults - only override what you need
# 2. For production, ensure JWT_SECRET_KEY is set and strong
# 3. For production, set ENVIRONMENT=production
# 4. For S3 or Azure storage, configure the appropriate credentials
# 5. Redis is optional but recommended for caching
# 6. Sentry DSN is optional but recommended for production error tracking
