<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build one Revit version at a time:
      dotnet build -c Release -p:RevitVersion=2024   (net48)
      dotnet build -c Release -p:RevitVersion=2025   (net8.0-windows)
      dotnet build -c Release -p:RevitVersion=2026   (net8.0-windows)
      dotnet build -c Release -p:RevitVersion=2027   (net10.0-windows)
    Output: bin/<Configuration>/<RevitVersion>/
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <TargetFramework Condition="'$(RevitVersion)' == '2024'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2025' Or '$(RevitVersion)' == '2026'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2027'">net10.0-windows</TargetFramework>

    <AssemblyName>RevitPy.Addin</AssemblyName>
    <RootNamespace>RevitPy.Addin</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>

    <OutputPath>bin\$(Configuration)\$(RevitVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>

    <Version>0.2.0</Version>
    <Company>RevitPy</Company>
    <Product>RevitPy</Product>
    <Description>Revit add-in that hosts CPython (via pythonnet) for the revitpy package.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == ''">
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference-only Revit API assemblies; Revit supplies the real ones at runtime. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="pythonnet" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
