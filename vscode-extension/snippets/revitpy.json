{
  "RevitPy script": {
    "prefix": "revitpy-script",
    "description": "A script for Run Script in Revit: connects the RevitPy API to the running Revit session (__revit__).",
    "body": [
      "\"\"\"${1:What this script does.}\"\"\"",
      "",
      "from revitpy import RevitAPI",
      "from revitpy.api import ${2:Wall}",
      "",
      "",
      "def main() -> None:",
      "    api = RevitAPI()",
      "    api.connect(__revit__)  # noqa: F821 - provided by RevitPy inside Revit",
      "    print(f\"Document: {api.get_document_info().title}\")",
      "",
      "    elements = api.query($2).execute()",
      "    print(f\"Found {len(elements)} ${2/(.*)/${1:/downcase}/} elements\")",
      "    $0",
      "",
      "",
      "if __name__ == \"__main__\":",
      "    main()",
      ""
    ]
  },
  "RevitPy query": {
    "prefix": "revitpy-query",
    "description": "Typed RevitPy query with a filter and sorting.",
    "body": [
      "${1:results} = (",
      "    api.query(${2:Wall})",
      "    .${3|contains,equals|}(\"${4:Name}\", \"${5:Exterior}\")",
      "    .order_by_ascending(\"${4:Name}\")",
      "    .execute()",
      ")",
      "$0"
    ]
  },
  "RevitPy transaction": {
    "prefix": "revitpy-transaction",
    "description": "RevitPy transaction: commits on success, rolls back if the block raises.",
    "body": [
      "with api.transaction(\"${1:Change name}\"):",
      "    for element in ${2:elements}:",
      "        element.set_parameter_value(\"${3:Comments}\", ${4:\"value\"})",
      "$0"
    ]
  },
  "Revit API transaction": {
    "prefix": "revit-transaction",
    "description": "Raw Revit API transaction (Autodesk.Revit.DB.Transaction) with commit/rollback.",
    "body": [
      "from Autodesk.Revit.DB import Transaction",
      "",
      "doc = __revit__.ActiveUIDocument.Document  # noqa: F821",
      "transaction = Transaction(doc, \"${1:Change name}\")",
      "transaction.Start()",
      "try:",
      "    ${2:pass}",
      "    transaction.Commit()",
      "except Exception:",
      "    transaction.RollBack()",
      "    raise",
      "$0"
    ]
  },
  "Revit API collector": {
    "prefix": "revit-collector",
    "description": "FilteredElementCollector for a built-in category (element instances only).",
    "body": [
      "from Autodesk.Revit.DB import BuiltInCategory, FilteredElementCollector",
      "",
      "doc = __revit__.ActiveUIDocument.Document  # noqa: F821",
      "${1:elements} = (",
      "    FilteredElementCollector(doc)",
      "    .OfCategory(BuiltInCategory.${2|OST_Walls,OST_Doors,OST_Windows,OST_Floors,OST_Rooms,OST_Levels|})",
      "    .WhereElementIsNotElementType()",
      "    .ToElements()",
      ")",
      "$0"
    ]
  },
  "RevitPy analysis": {
    "prefix": "revitpy-analysis",
    "description": "Register an analysis callable through the Live Server's bridge/analyze method.",
    "body": [
      "from revitpy.revit.live import register_analysis",
      "",
      "",
      "@register_analysis(\"${1:my_analysis}\")",
      "def ${1:my_analysis}(elements, options, uiapp):",
      "    ${2:return {\"count\": len(elements)}}",
      "$0"
    ]
  }
}
